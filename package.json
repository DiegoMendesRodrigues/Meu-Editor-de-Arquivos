{
  "name": "meu-editor-de-arquivos",
  "productName": "Meu Editor de Arquivos",
  "version": "1.1.0",
  "description": "Editor de arquivos leve para Windows e Linux, com foco em Markdown e código.",
  "author": {
    "name": "Diego Mendes Rodrigues",
    "email": "suporte@meueditordearquivos.aplicativoia.online",
    "url": "https://www.linkedin.com/in/diegomendesrodrigues/"
  },
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web",
    "test": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "typecheck:e2e": "tsc --noEmit -p e2e/tsconfig.json",
    "manual:capture": "tsx scripts/capture-manual.mts",
    "manual:build": "tsx scripts/build-manual.mts",
    "manual": "npm run build && npm run manual:capture && npm run manual:build",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux",
    "dist:store": "npm run build && electron-builder --win appx --x64 --arm64",
    "store:assets": "python scripts/store-assets.py"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@prettier/plugin-php": "0.26.0",
    "@prettier/plugin-xml": "3.4.2",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@tiptap/extension-image": "3.32.3",
    "@tiptap/extension-list": "3.32.3",
    "@tiptap/extension-table": "3.32.3",
    "@tiptap/markdown": "3.32.3",
    "@tiptap/pm": "3.32.3",
    "@tiptap/react": "3.32.3",
    "@tiptap/starter-kit": "3.32.3",
    "@wasm-fmt/clang-format": "23.1.1",
    "@wasm-fmt/gofmt": "0.7.3",
    "@wasm-fmt/lua_fmt": "0.3.3",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "@wasm-fmt/shfmt": "0.2.7",
    "@xmldom/xmldom": "^0.9.12",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "ajv": "^8.20.0",
    "electron-log": "^5.4.4",
    "lucide-react": "^1.76.0",
    "monaco-editor": "^0.57.0",
    "node-pty": "^1.1.0",
    "prettier": "3.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-resizable-panels": "^4.24.1",
    "sql-formatter": "15.10.0",
    "ws": "^8.23.0",
    "xpath": "^0.0.34",
    "yaml": "^2.9.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^6.3.0",
    "dictionary-de": "^3.0.0",
    "dictionary-en": "^4.0.0",
    "dictionary-es": "^4.0.0",
    "dictionary-fr": "^3.0.0",
    "dictionary-pt": "^4.0.0",
    "dictionary-pt-pt": "^2.0.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "hunspell-asm": "^4.0.2",
    "marked": "^18.2.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "homepage": "https://meueditordearquivos.aplicativoia.online/?lang=en",
  "repository": {
    "type": "git",
    "url": "https://github.com/DiegoMendesRodrigues/Meu-Editor-de-Arquivos.git"
  }
}
