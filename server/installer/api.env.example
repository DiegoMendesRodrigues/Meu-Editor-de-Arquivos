# Desenvolvido por Diego Mendes Rodrigues - https://www.linkedin.com/in/diegomendesrodrigues/
# Configuração da API do Meu Editor de Arquivos. Guarde este arquivo com permissão 600.

# Banco MySQL 8+ / MariaDB 10.6+ (banco vazio, utf8mb4). Sem esta linha a API usa memória (dados somem ao parar).
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/meu_editor

# Endereço de escuta. Mantenha 127.0.0.1 e publique por um proxy reverso com HTTPS.
HOST=127.0.0.1
PORT=3000

# Proxy reverso na frente: número de proxies (1 = só o nginx). Os limites por IP usam o IP real do cliente.
# "true" confia em todos os proxies e só é seguro se o proxy substituir o X-Forwarded-For.
TRUST_PROXY=1

# Envio de e-mail (redefinição de senha). Porta 465 = TLS direto.
# SMTP_HOST=smtp.exemplo.com
# SMTP_PORT=465
# SMTP_USER=usuario
# SMTP_PASS=senha
# SMTP_FROM=nao-responda@exemplo.com

# Em produção: exige DATABASE_URL e SMTP (a API não inicia sem eles). Comente só para testes locais.
NODE_ENV=production

# Cadastro direto na API (POST /v1/auth/register). O padrão é o cadastro só pelo site; ligue para um servidor próprio.
# ALLOW_REGISTER=true

# Cadastro pela página de planos do site: chave secreta compartilhada com o site (config.php, área "api").
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"  (mínimo de 32 caracteres)
# SITE_API_KEY=

# Assinaturas pela Stripe: segredo do endpoint de webhook (Dashboard > Workbench > Webhooks), apontado para
# https://SEU-DOMINIO/v1/billing/stripe-webhook com os eventos checkout.session.completed, invoice.paid,
# invoice.payment_failed, customer.subscription.updated e customer.subscription.deleted.
# STRIPE_WEBHOOK_SECRET=whsec_...
