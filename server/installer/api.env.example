# Configuração da API do Meu Editor de Arquivos. Guarde este arquivo com permissão 600.

# Banco MySQL 8+ / MariaDB 10.6+ (banco vazio, utf8mb4). Sem esta linha a API usa memória (dados somem ao parar).
DATABASE_URL=mysql://usuario:senha@127.0.0.1:3306/meu_editor

# Endereço de escuta. Mantenha 127.0.0.1 e publique por um proxy reverso com HTTPS.
HOST=127.0.0.1
PORT=3000

# "true" quando houver proxy reverso na frente (os limites por IP usam o IP real do cliente).
TRUST_PROXY=true

# Não defina NODE_ENV=production enquanto não houver um serviço de e-mail real ligado em src/app.ts (Mailer):
# nesse modo a API se recusa a iniciar.
